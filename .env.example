# Copy this file to `.env` and fill in the values you need.
#
# Example:
#   cp .env.example .env

# Hugging Face token for local FLUX Fill model access.
HF_TOKEN=

# Optional: Black Forest Labs API key if you switch to API-based FLUX Fill.
BFL_API_KEY=

# Optional: future OpenAI-based evaluation or assistants.
OPENAI_API_KEY=
